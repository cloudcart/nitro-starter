# Copy to `.env` for local development, or run `cloudcart nitrogen env pull`
# to fetch the values of a linked storefront.

# The store's domain, e.g. shop.example.com.
PUBLIC_STORE_DOMAIN=
# The storefront's public Storefront API access token.
PUBLIC_STOREFRONT_API_TOKEN=
# The storefront's private token, issued with it in the CloudCart admin. A secret:
# used only on the server, it lets the API see each visitor's IP address.
PRIVATE_STOREFRONT_API_TOKEN=
# Signs the session cookie: a random string of at least 32 characters, made for
# this storefront alone (`openssl rand -hex 32`). Required.
SESSION_SECRET=
