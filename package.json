{
  "name": "nitrogen-starter",
  "private": true,
  "license": "MIT",
  "sideEffects": false,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "preview": "vite preview",
    "codegen": "graphql-codegen --config codegen.ts && react-router typegen",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "node scripts/check-design-tokens.mjs && node scripts/check-translations.mjs && node scripts/check-kept-pages.mjs && eslint --max-warnings 0 . && prettier --check .",
    "format": "prettier --write .",
    "check": "npm run codegen && npm run typecheck && npm run lint && npm run build",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@cloudcart/nitrogen": "^2.3.0",
    "@cloudcart/nitrogen-react": "^2.3.0",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@heroicons/react": "^2.2.0",
    "animate.css": "^4.1.1",
    "isbot": "^5.1.22",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.16.0"
  },
  "devDependencies": {
    "@cloudcart/nitrogen-codegen": "^2.3.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint-react/eslint-plugin": "^5.24.9",
    "@eslint/js": "^10.0.1",
    "@graphql-codegen/cli": "^7.4.5",
    "@react-router/dev": "^7.16.0",
    "@react-router/fs-routes": "^7.16.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "graphql": "^16.10.0",
    "graphql-config": "^5.1.8",
    "prettier": "^3.9.9",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.2.4",
    "vite-tsconfig-paths": "^4.3.1"
  },
  "engines": {
    "node": "^22 || ^24"
  },
  "overrides": {
    "lodash": "^4.18.1",
    "@tailwindcss/typography": {
      "postcss-selector-parser": "7.1.6"
    }
  },
  "simple-git-hooks": {
    "pre-commit": "node scripts/require-committed-tree.mjs && npm run check && git diff --exit-code -- storefrontapi.generated.d.ts"
  }
}
